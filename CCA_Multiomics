protein_matrix_reduced <- protein_matrix[, -high_cor_protein]
dim(lipid_matrix_reduced)
dim(protein_matrix_reduced)
# Step 1: Perform Regularized CCA

rcca_result <- CCA(lipid_matrix_reduced, protein_matrix_reduced, typex = "standard", typez = "standard", K = 5)

# Step 2: Extract canonical loadings
lipid_loadings <- rcca_result$u  # Loadings for lipids (255 x 5)
protein_loadings <- rcca_result$v  # Loadings for proteins (100 x 5)

# Step 3: Combine lipid and protein loadings
