cor_protein <- cor(protein_matrix)

# Find variables with correlation > 0.95 (or another threshold)
high_cor_lipid <- findCorrelation(cor_lipid, cutoff = 0.95)
high_cor_protein <- findCorrelation(cor_protein, cutoff = 0.99)
# Remove highly correlated variables
