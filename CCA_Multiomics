# Function to get top N elements for a given canonical variate
get_top_elements <- function(loadings, element_names, N) {
  # Get absolute loadings
  abs_loadings <- abs(loadings)

  # Sort and get top N indices
  top_indices <- order(abs_loadings, decreasing = TRUE)[1:N]

  # Return top element names and their loadings
  data.frame(
    Element = element_names[top_indices],
    Loading = loadings[top_indices]
  )
}

