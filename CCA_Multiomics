# Number of top elements to extract for each canonical variate
N <- 30  # You can adjust this number

# Function to get top N elements for a given canonical variate
get_top_elements <- function(loadings, element_names, N, variate_name) {
  # Get absolute loadings
  abs_loadings <- abs(loadings)

  # Sort and get top N indices
  top_indices <- order(abs_loadings, decreasing = TRUE)[1:N]

  # Return top element names, their loadings, and the canonical variate name
  data.frame(
    Element = element_names[top_indices],
    Loading = loadings[top_indices],
    Canonical_Variate = variate_name
  )
}

# Get lipid and protein names
lipid_names <- colnames(lipid_matrix_reduced)  # Names of lipids

protein_names <- colnames(protein_matrix_reduced)  # Names of proteins

# Initialize an empty data frame to store all top elements
top_elements_all <- data.frame()

# Loop through each canonical variate
for (k in 1:ncol(rcca_result$u)) {
  # Get top elements for the k-th canonical variate
  top_lipids <- get_top_elements(rcca_result$u[, k], lipid_names, N, paste0("CV", k))
  top_proteins <- get_top_elements(rcca_result$v[, k], protein_names, N, paste0("CV", k))

  # Combine into a single data frame
  top_elements_all <- rbind(top_elements_all, top_lipids, top_proteins)
}

# Add a column to indicate whether the element is a lipid or protein
top_elements_all$Type <- ifelse(grepl("^Lipid", top_elements_all$Element), "Lipid", "Protein")

# Display the table

View(top_elements_all)
