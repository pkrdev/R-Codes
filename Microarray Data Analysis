#!/usr/bin/Rscript --slave

# The job of this pipeline is to obtain the expression value of new patient microarray sample.This Pipeline is for Affymetrix HT_HG_133U_A
# platform. In this pipeline, the new patient input data is normalized with the already existing 450 microarray sample

###################################################### Loading essential Libraries #################################

library(stringr)
library(affy)
library(limma)
library(hthgu133acdf)
library(genefilter)


#cat("Do You have Sample replicates (T for Yes or F for No)");

#rep <- NULL;

#raw <- readLines(file("stdin"),1)
#
